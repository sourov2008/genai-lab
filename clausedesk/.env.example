# Copy to .env and fill in local values. Do not commit .env.

APP_ENV=local

DATABASE_URL=postgresql+asyncpg://clausedesk:clausedesk@localhost:5432/clausedesk

# LLM
# Provider can be switched between "openai" and "groq" via the Factory pattern.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=text-embedding-3-small
# A/B extraction prompts: v1 (base) or v2 (few-shot + refusal). Loads prompts/extract_{version}.md
PROMPT_VERSION=v1

# Change this to a secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# Observability (Langfuse) - Get keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
